{
    "hosting": {
        "site": "recovery-base-au",
        "public": ".",
        "ignore": [
            "firebase.json",
            ".firebaserc",
            ".git/**",
            ".gitignore",
            "**/.DS_Store",
            "**/node_modules/**"
        ],
        "cleanUrls": true,
        "trailingSlash": false,
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "Link",
                        "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </llms-full.txt>; rel=\"alternate\"; type=\"text/plain\""
                    }
                ]
            },
            {
                "source": "**/*.txt",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/plain; charset=utf-8"
                    },
                    {
                        "key": "X-Robots-Tag",
                        "value": "all"
                    }
                ]
            },
            {
                "source": "/sitemap.xml",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/xml; charset=utf-8"
                    }
                ]
            },
            {
                "source": "/feed.xml",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/rss+xml; charset=utf-8"
                    }
                ]
            }
        ]
    }
}